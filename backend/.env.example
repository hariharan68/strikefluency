# StrikeFluency â€” Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Database (your local Postgres)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/strikefluency

# JWT â€” generate a real secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
ENVIRONMENT=development
# Permanent safety boundary. StrikeFluency never submits broker orders.
EXECUTION_MODE=paper_only
BROKER_ACCESS_MODE=market_data_read_only

# Market data
MOCK_MARKET_DATA=true
NIFTY_LOT_SIZE=65

# Market data
MARKET_DATA_PROVIDER=fyers

# Fyers credentials
FYERS_CLIENT_ID=FXXXXXXXXXXX
FYERS_APP_ID=XXXXXXXXXXXXXX
FYERS_SECRET_ID=BXXXXXXXXXXXXXX
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/auth/fyers/callback
FYERS_ACCESS_TOKEN=
BROKER_TOKEN_ENC_KEY=




# Discipline defaults (used when seeding rules for a new user)
DEFAULT_MAX_TRADES_PER_DAY=3
DEFAULT_COOLDOWN_MINUTES=15
DEFAULT_MAX_DAILY_LOSS_PCT=2.0
DEFAULT_INITIAL_CAPITAL=100000

# Google OAuth. Create a Web application client in Google Cloud Console and
# register the redirect URI below byte-for-byte. It points at the Vite dev origin
# rather than the backend port, because Vite proxies /api — so the backend port
# can change without touching the Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Required in production so only one API worker runs state-mutating scheduler jobs.
REDIS_URL=redis://localhost:6379/0
SCHEDULER_LEADER_TTL_SECONDS=30
JTI_DENYLIST_ENABLED=false

# Zerodha Kite Connect (read-only market data)
# MARKET_DATA_PROVIDER=kite
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/kite/callback

# Frontend base URL used after Fyers callback
FRONTEND_URL=http://localhost:5173

